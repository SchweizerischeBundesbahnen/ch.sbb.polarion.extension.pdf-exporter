# Manually added from https://raw.githubusercontent.com/github/gitignore/master/Java.gitignore
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Additonal not included in Java.gitignore
.history/
.idea/*

# code style config
!.idea/codeStyles
.idea/codeStyles/*
!.idea/codeStyles/Project.xml
!.idea/codeStyles/codeStyleConfig.xml

target/
*.iml
dependency-reduced-pom.xml

# Generated into the app webapp by the build: the Vite bundle under app/ and the markdown2html articles
# under html/. Everything else there - WEB-INF/web.xml, the menu icons under images/, html/.gitkeep - is
# source and committed, so only these two are ignored (ignoring the whole webapp would silently drop a newly
# added icon from git).
src/main/resources/webapp/pdf-exporter-app/app/
src/main/resources/webapp/pdf-exporter-app/html/*.html
# The documentation search index, built from those articles by ui/scripts/build-docs-index.mjs before every
# build, dev server, typecheck and test run.
ui/src/docs/search-index.json
README.html

node/
node_modules/

# Eclipse / jdtls (Eclipse JDT Language Server) metadata — generated by Claude Code's jdtls-lsp plugin, not used by IntelliJ
.project
.classpath
.factorypath
.settings/
bin/
