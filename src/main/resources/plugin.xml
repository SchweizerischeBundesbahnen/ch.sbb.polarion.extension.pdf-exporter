<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin>
    <extension
            point="com.polarion.portal.tomcat.webapps">
        <webapp
                name="polarion/pdf-exporter"
                contextRoot="webapp/pdf-exporter">
        </webapp>
    </extension>

    <!-- The React administration app. Serves the Vite bundle, the build-generated help articles and the
         administration menu icons. -->
    <extension
            point="com.polarion.portal.tomcat.webapps">
        <webapp
                name="polarion/pdf-exporter-app"
                contextRoot="webapp/pdf-exporter-app">
        </webapp>
    </extension>
    <!-- Polarion renders a <script> tag for this file into the main portal page (authapp/index.jsp),
         for every user and without the scriptInjection.* administrator configuration the toolbar
         buttons used to need. The servlet serves it flat by its base name at
         /polarion/codemirror-modes/pdf-exporter-ui-loader.js, so that name must stay unique across all
         plugins. The response is cached as immutable, so the file only loads
         webapp/pdf-exporter/js/toolbar-injector.js, which holds the actual buttons.
         Point `location` at a single file: a directory contributes every file in it to every Polarion
         page. The extension registry is read at startup, so a change here needs a Polarion restart. -->
    <extension
            point="com.polarion.portal.tomcat.externalJsFile">
        <file location="external-js/pdf-exporter-ui-loader.js"/>
    </extension>
</plugin>
